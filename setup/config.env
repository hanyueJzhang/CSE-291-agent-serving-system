# Pinned versions shared by the whole team. Change only via PR.
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_CPP_COMMIT=972b5fcc19670e597f8de9bf5cacfb85752a5fff   # pinned 2026-10-12, first successful CUDA 13.3 build on the 3080 server

# Fixed model + quantization for all main experiments
MODEL_HF_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF   # TODO: team to confirm final model
MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf

# Default server params (Phase 1 sweeps override CTX / PARALLEL)
SERVER_PORT=${SERVER_PORT:-8080}
CTX=${CTX:-8192}
PARALLEL=${PARALLEL:-4}
NGL=${NGL:-99}
